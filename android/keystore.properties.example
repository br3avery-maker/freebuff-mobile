# keystore.properties 模板 —— 复制为 android/keystore.properties 并填入真实口令。
# 真实的 keystore.properties 已被 .gitignore 忽略, 绝不要提交任何真实口令。
#
# 推荐做法: 直接运行 scripts/gen-release-keystore.sh, 它会生成 keystore 并自动写好这个文件。
#
# 路径说明: storeFile 相对 app/ 模块解析, 因此 ../freebuff-release.jks 指向 android/freebuff-release.jks。
# 若 android/keystore.properties 不存在, release 变体会回退用 debug 证书签名(可安装, 但不可上架)。
storeFile=../freebuff-release.jks
storePassword=CHANGE_ME
keyAlias=freebuff
keyPassword=CHANGE_ME
