# 统一行尾:仓库内一律 LF,避免 Windows 上 checkout 出 CRLF 导致
# Linux / GitHub Actions 上 gradlew 与 *.sh 无法执行(`bash\r`: No such file)。
* text=auto eol=lf

*.sh    text eol=lf
gradlew text eol=lf

# Windows 批处理必须是 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不得被行尾/编码转换改写
*.jar   binary
*.png   binary
*.apk   binary
*.jks   binary
